# Copy to .env (gitignored) and pass with `canary run|compare ... --env-file .env`.
# Harbor loads it into its own process and forwards what each harness needs.
# Never commit real values; pins in canary.toml refuse secret-looking env keys.

# Claude Code: an API key, or a subscription token from `claude setup-token`.
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_FORCE_OAUTH=1        # prefer the OAuth token when both are set

# Codex
# OPENAI_API_KEY=
